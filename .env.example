# GMO Coin 外国為替FX API キー
# 取得先: https://coin.z.com/jp/corporate/account/fx-api/
# API キー作成後 30 日間は取引手数料が無料
GMO_FX_API_KEY=your_api_key_here
GMO_FX_API_SECRET=your_api_secret_here

# 環境 (production / test)
GMO_FX_ENV=production

# 通知 (Discord Webhook URL) - フォワードテスト時の通知用
DISCORD_WEBHOOK_URL=

# ログレベル
LOG_LEVEL=INFO
